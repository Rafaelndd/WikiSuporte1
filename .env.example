# WikiSuporte — Variáveis de ambiente (cópia como .env e preencha os valores)
# No servidor: cp .env.example .env && editar .env

# --- OBRIGATÓRIAS ---
TECNUV_USER=
TECNUV_PASS=
LGPD_SECRET_KEY=

# --- BANCO DE DADOS (PostgreSQL + pgvector) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=central_chamados
DB_USER=postgres
DB_PASS=

# --- OPCIONAIS: Integração GoTo ---
# GOTO_CLIENT_ID=
# GOTO_CLIENT_SECRET=
# GOTO_REFRESH_TOKEN=

# --- OPCIONAIS: LLM / IA ---
# GEMINI_API_KEY=
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_API_KEY=

# --- OPCIONAIS: Sistema ---
# MODO_HEADLESS=True
# VERSAO_ATUAL_SISTEMA=2.9.257.0
# APP_SALT_KEY= (obrigatória para hashing LGPD de telefones/e-mails — sem ela,
# gerar_hash_lgpd() falha explicitamente em vez de usar um salt fraco embutido no código)
# TECNUV_BASE_URL=https://postogestor.com.br
# --- E-mail (feedback, monitor IMAP, etc.) — Gmail: senha de app com 2FA ---
# EMAIL_SUPORTE_HOST=smtp.gmail.com
# EMAIL_SUPORTE_PORT=465
# EMAIL_SUPORTE_USER=sua.conta@gmail.com
# EMAIL_SUPORTE_PASS=   # opcional: pode ficar só em .streamlit/secrets.toml como EMAIL_SUPORTE_PASS
# EMAIL_SUPORTE_NAME=WikiSuporte
# Opcional: destino dos feedbacks (default = mesmo que EMAIL_SUPORTE_USER)
# FEEDBACK_TO_EMAIL=
# Último recurso se SSL falhar (proxy/antivírus): desliga verificação do certificado SMTP
# EMAIL_SMTP_SSL_INSECURE=
