# WikiSuporte — Variáveis de ambiente (cópia como .env e preencha os valores)
# No servidor: cp .env.example .env && editar .env

# --- OBRIGATÓRIAS ---
TECNUV_USER=
TECNUV_PASS=
LGPD_SECRET_KEY=

# --- BANCO DE DADOS (PostgreSQL + pgvector) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=central_chamados
DB_USER=postgres
DB_PASS=

